# ════════════════════════════════════════════════════════════════
# .env.example  —  Copy to .env and fill in real values.
#                  NEVER commit the actual .env file to git!
# ════════════════════════════════════════════════════════════════

# ── Flask Core ───────────────────────────────────────────────────
FLASK_ENV=development           # development | production
FLASK_DEBUG=1                   # 0 in production
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ─────────────────────────────────────────────────────
# SQLite (default, no extra config needed):
DATABASE_URL=sqlite:///phishing_detector.db

# PostgreSQL example (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/phishing_db

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=another-random-64-char-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# ── Google Safe Browsing API ─────────────────────────────────────
# Get a key at: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=YOUR_GSB_API_KEY_HERE

# ── VirusTotal API ───────────────────────────────────────────────
# Get a free key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=YOUR_VT_API_KEY_HERE

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_SCAN=10 per minute   # per-IP limit on /api/scan/*
RATE_LIMIT_AUTH=5 per minute    # per-IP limit on /api/auth/*

# ── Redis (optional — for shared rate limiting across multiple workers) ──
# Uncomment when running multiple gunicorn workers or deploying on Render with Redis:
# REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed origins (use * for dev only)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── Server ───────────────────────────────────────────────────────
PORT=5000
